import Sal.MRDTs.Paper1.FugueMaxNaturalSequence
import Sal.MRDTs.Instances.FugueMaxSequential
import Sal.MRDTs.Paper1.ProjectedCriterion

/-! Independent controls distinguish full causal replay from specification
conflict visibility. The ordinary tombstone list contains no tree coordinates.
-/
namespace Sal.MRDTs.Paper1.FugueMaxNaturalControls
open Foundation FugueMaxNaturalSequence

/-- Different anchors commute unless one request creates the other's anchor.
This holds on arbitrary lists, including malformed or unreachable ones. -/
theorem insertAfter_commutes (order : List Nat) (x a y b : Nat)
    (ab : a ≠ b) (xb : x ≠ b) (ya : y ≠ a) :
    insertAfter (insertAfter order x a) y b =
      insertAfter (insertAfter order y b) x a := by
  induction order with
  | nil => simp [insertAfter]
  | cons h t ih =>
    by_cases ha : h = a <;> by_cases hb : h = b
    all_goals simp_all [insertAfter]

theorem mem_insertAfter (order : List Nat) (id left x : Nat) :
    x ∈ insertAfter order id left ↔ x ∈ order ∨ left ∈ order ∧ x = id := by
  induction order with
  | nil => simp [insertAfter]
  | cons h t ih =>
    by_cases same : h = left
    · subst h
      simp only [insertAfter,ite_true,List.mem_cons,true_or,true_and]
      tauto
    · simp only [insertAfter,if_neg same,List.mem_cons,ih]
      have diff : left ≠ h := Ne.symm same
      simp only [diff,false_or]
      tauto

theorem legal_insert_preserved (s : Buffer) (x a y b : Nat)
    (yx : y ≠ x) (bx : b ≠ x) :
    legal (step s (.insertAfter x a)) (.insertAfter y b) ↔ legal s (.insertAfter y b) := by
  simp only [legal,step,mem_insertAfter]
  simp [yx,bx]

theorem insert_steps_commute (s : Buffer) (x a y b : Nat)
    (ab : a ≠ b) (xb : x ≠ b) (ya : y ≠ a) :
    step (step s (.insertAfter x a)) (.insertAfter y b) =
      step (step s (.insertAfter y b)) (.insertAfter x a) := by
  cases s with
  | mk order deleted =>
    simp only [step]
    rw [insertAfter_commutes order x a y b ab xb ya]

/-- Guarded-language commutation, not merely commutation of total step code.
Distinct incoming identities are explicit; freshness is checked at each state. -/
theorem distinct_anchor_language_commutes (x a y b : Nat)
    (xy : x ≠ y) (ab : a ≠ b) (xb : x ≠ b) (ya : y ≠ a) :
    spec.Commutes (.insertAfter x a) (.insertAfter y b) := by
  apply HistoryMachine.commutes_of_diamond machine
  intro s t
  have swap : ∀ (x a y b : Nat), x ≠ y → a ≠ b → x ≠ b → y ≠ a →
      Runs machine.transition s [.update (.insertAfter x a),.update (.insertAfter y b)] t →
      Runs machine.transition s [.update (.insertAfter y b),.update (.insertAfter x a)] t := by
    intro x a y b xy ab xb ya run
    cases run with
    | cons first rest =>
      cases rest with
      | cons second tail =>
        cases tail
        change legal s (.insertAfter x a) ∧ _ at first
        obtain ⟨gx,rfl⟩ := first
        change legal (step s (.insertAfter x a)) (.insertAfter y b) ∧ _ at second
        obtain ⟨gy,rfl⟩ := second
        have gy0 := (legal_insert_preserved s x a y b (Ne.symm xy) (Ne.symm xb)).mp gy
        have gxafter := (legal_insert_preserved s y b x a xy (Ne.symm ya)).mpr gx
        exact .cons ⟨gy0,rfl⟩ (.cons ⟨gxafter,insert_steps_commute s x a y b ab xb ya⟩ (.nil _))
  exact ⟨swap x a y b xy ab xb ya,
    swap y b x a (Ne.symm xy) (Ne.symm ab) ya xb⟩

open Sal.EmbedRGA Instances.SidedEmbedRGA Instances.SidedEmbedRGA.FugueMax

def g1 : MRec := mGenInsAt unaryCode [] 1 1 0
def g2 : MRec := mGenInsAt unaryCode [] 0 2 0
def g3 : MRec := mGenInsAt unaryCode [g2] 2 3 0
def g4 : MRec := mGenInsAt unaryCode [g1,g2,g3] 1 4 0
def g6 : MRec := mGenInsAt unaryCode [g2,g3] 2 6 1
def g7 : MRec := mGenInsAt unaryCode [g2,g3,g6] 2 7 0
def g8 : MRec := mGenInsAt unaryCode [g1,g2,g3,g4] 1 8 3
abbrev I := Fin 7
def record (i : I) : MRec := match i.val with
  | 0 => g1 | 1 => g2 | 2 => g3 | 3 => g4 | 4 => g6 | 5 => g7 | _ => g8
def action (i : I) : Action := ofMessage (record i)
def indices : List I := [0,1,2,3,4,5,6]
def witness : List I := [1,2,5,0,3,6,4]
def past (i : I) : Finset I := match i.val with
  | 0 | 1 => ∅ | 2 => {1} | 3 => {0,1,2} | 4 => {1,2}
  | 5 => {1,2,4} | _ => {0,1,2,3}
def visibleBefore (i j : I) : Prop := i ∈ past j
instance (i j : I) : Decidable (visibleBefore i j) := by unfold visibleBefore; infer_instance

/-- The seven messages are generated by the unchanged source positional API.
Expected left origins and sides are independently hand-derived. -/
theorem source_message_fields :
    g1.op = .ins 0 .R ∧ g2.op = .ins 0 .R ∧
    g3.op = .ins 2 .L ∧ g4.op = .ins 1 .L ∧
    g6.op = .ins 3 .R ∧ g7.op = .ins 3 .L ∧ g8.op = .ins 3 .R ∧
    g6.lo = 3 ∧ g7.lo = 0 ∧ g8.lo = 3 := by decide +kernel

theorem source_display : mView unaryCode (indices.map record) = [4,1,7,3,6,8,2] ∧
    mView unaryCode (indices.map record) ≠ [7,4,1,3,8,6,2] := by decide +kernel

theorem witness_permutation : witness.Perm indices := by decide +kernel

theorem witness_display :
    FugueMaxClientCandidate.visible ((witness.map action).foldl step FugueMaxClientCandidate.initial) =
      [4,1,7,3,6,8,2] ∧
    FugueMaxClientCandidate.visible ((witness.map action).foldl step FugueMaxClientCandidate.initial) ≠ [] := by
  decide +kernel

/-- The only inverted visibility edge connects different insertion anchors,
and the guarded independent history language proves those operations commute. -/
theorem inverted_pair_commutes : spec.Commutes (action 4) (action 5) := by
  change spec.Commutes (.insertAfter 6 3) (.insertAfter 7 0)
  exact distinct_anchor_language_commutes 6 3 7 0 (by decide) (by decide) (by decide) (by decide)

theorem witness_respects_spec_visibility :
    respects witness (fun i j => visibleBefore i j ∧ ¬ spec.Commutes (action i) (action j)) := by
  have order : respects witness (fun i j => visibleBefore i j ∧ ¬ (i = 4 ∧ j = 5)) := by
    unfold respects
    decide +kernel
  apply order.imp
  intro a b no edge
  apply no
  refine ⟨edge.1,?_⟩
  rintro ⟨rfl,rfl⟩
  exact edge.2 inverted_pair_commutes

/-- Full visibility is strictly stronger: every such schedule fails the
hand-derived output. This is a counterfactual control, not an RA obstruction. -/
theorem no_full_causal_replay : ∀ π ∈ indices.permutations',
    respects π visibleBefore →
    FugueMaxClientCandidate.visible ((π.map action).foldl step FugueMaxClientCandidate.initial) ≠
      [4,1,7,3,6,8,2] := by
  unfold respects
  decide +kernel

private theorem sInsert_comm_strict (x y : SRec)
    (strict : keyLt (sKey x.2.2) (sKey y.2.2) = true) (s : SState) :
    sInsert x (sInsert y s) = sInsert y (sInsert x s) := by
  have reverse := keyLt_asymm strict
  induction s with
  | nil => simp [sInsert,strict,reverse]
  | cons h t ih =>
    by_cases hx : keyLt (sKey h.2.2) (sKey x.2.2) = true
    · have hy := keyLt_trans hx strict
      simp [sInsert,hx,hy,strict,reverse]
    · by_cases hy : keyLt (sKey h.2.2) (sKey y.2.2) = true
      · simp [sInsert,hx,hy,reverse]
      · simp [sInsert,hx,hy,ih]

/-- Raw commutation on all concrete states, including malformed scratch states.
This checks the actual paper-order boundary for the inverted causal pair. -/
theorem inverted_pair_raw_commutes :
    (datatype unaryCode).toUpdateSig.commutes (eventOf g6) (eventOf g7) := by
  intro s
  cases s with
  | mk live births =>
    have h6 : g6.op = .ins 3 .R := source_message_fields.2.2.2.2.1
    have h7 : g7.op = .ins 3 .L := source_message_fields.2.2.2.2.2.1
    have fields : g6.ts = 6 ∧ g7.ts = 7 := by decide +kernel
    have strict : keyLt (sKey (fmCoordOf unaryCode g6.chain))
        (sKey (fmCoordOf unaryCode g7.chain)) = true := by decide +kernel
    change rawUpdate unaryCode (rawUpdate unaryCode ⟨live,births⟩ (eventOf g6)) (eventOf g7) =
      rawUpdate unaryCode (rawUpdate unaryCode ⟨live,births⟩ (eventOf g7)) (eventOf g6)
    simp only [rawUpdate,recordOf,eventOf,mIsIns,h6,h7]
    apply congrArg₂ State.mk
    · simp only [mStep]
      rw [fields.1,fields.2]
      by_cases p6 : 6 ∈ sIds live <;> by_cases p7 : 7 ∈ sIds live
      all_goals simp only [p6,p7,ite_true,ite_false,mem_sIds_sInsert]
      all_goals try rfl
      exact (sInsert_comm_strict (6,6,fmCoordOf unaryCode g6.chain)
        (7,7,fmCoordOf unaryCode g7.chain) strict live).symm
    · exact Finset.insert_comm _ _ _

def LegalActions : Buffer → List Action → Prop
  | _,[] => True
  | s,a :: rest => legal s a ∧ LegalActions (step s a) rest

theorem witness_legal : LegalActions FugueMaxClientCandidate.initial (witness.map action) := by
  change LegalActions FugueMaxClientCandidate.initial
    [.insertAfter 2 0,.insertAfter 3 0,.insertAfter 7 0,.insertAfter 1 0,
      .insertAfter 4 0,.insertAfter 8 3,.insertAfter 6 3]
  simp only [LegalActions,legal]
  decide +kernel

theorem witness_admitted : spec.admits
    ((witness.map action).map SeqLabel.update ++ [.query () [4,1,7,3,6,8,2]]) := by
  have runs : ∀ (ops : List Action) (s : Buffer), LegalActions s ops →
      Runs machine.transition s (ops.map SeqLabel.update) (ops.foldl step s) := by
    intro ops
    induction ops with
    | nil => intro s _; exact .nil s
    | cons a rest ih =>
      intro s h
      exact .cons ⟨h.1,rfl⟩ (ih (step s a) h.2)
  change ∃ final, Runs machine.transition FugueMaxClientCandidate.initial _ final
  refine ⟨(witness.map action).foldl step FugueMaxClientCandidate.initial,
    (runs _ _ witness_legal).append ?_⟩
  exact .cons ⟨rfl,witness_display.1.symm⟩ (.nil _)

theorem witness_respects_raw_conflict_visibility :
    respects witness (fun i j => visibleBefore i j ∧
      ¬ (datatype unaryCode).toUpdateSig.commutes (eventOf (record i)) (eventOf (record j))) := by
  have order : respects witness (fun i j => visibleBefore i j ∧ ¬ (i = 4 ∧ j = 5)) := by
    unfold respects
    decide +kernel
  apply order.imp
  intro a b no edge
  apply no
  refine ⟨edge.1,?_⟩
  rintro ⟨rfl,rfl⟩
  exact edge.2 inverted_pair_raw_commutes

/-- The unchanged operation policy has no concurrent conflict-order edges. -/
def noConflict : OperationPolicy Payload := ⟨fun _ _ => False⟩

/-- This fixture has an admitted witness for both exact ordering relations.
Visibility is supplied independently; neither order relation is substituted
with full visibility or an executable approximation of specification conflict. -/
theorem actual_order_witness
    (C : ReplayContext (datatype unaryCode).toUpdateSig)
    (visibility : ∀ i j, C.vis (eventOf (record i)) (eventOf (record j)) ↔ visibleBefore i j) :
    let π := witness.map (fun i => eventOf (record i))
    respects π (paperOrder noConflict C
      (↑(indices.map (fun i => eventOf (record i))).toFinset : Set (Op Payload))) ∧
    respects π (projectedSpecVisibility (fun e => ofMessage (recordOf e)) spec C) ∧
    spec.admits (projectedLabels (D := datatype unaryCode)
      (fun e => ofMessage (recordOf e)) π ++ [.query () [4,1,7,3,6,8,2]]) := by
  simp only
  refine ⟨?_,?_,?_⟩
  · change (witness.map (fun i => eventOf (record i))).Pairwise _
    rw [List.pairwise_map]
    apply witness_respects_raw_conflict_visibility.imp
    intro a b no edge
    rcases edge with causal | concurrent
    · exact no ⟨(visibility b a).mp causal.1,causal.2⟩
    · simp [noConflict] at concurrent
  · change (witness.map (fun i => eventOf (record i))).Pairwise _
    rw [List.pairwise_map]
    apply witness_respects_spec_visibility.imp
    intro a b no edge
    apply no
    refine ⟨(visibility b a).mp edge.1,?_⟩
    simpa [recordOf,eventOf,action] using edge.2
  · simpa [projectedLabels,List.map_map,recordOf,eventOf,action] using witness_admitted

/-- The old structural-depth construction cannot simply be reused for the
new left-origin ADT. Even a three-insert concurrent history separates them. -/
theorem structural_depth_counterfactual :
    mView unaryCode [g1,g2,g3] = [1,3,2] ∧
    FugueMaxClientCandidate.visible
      (([g2,g1,g3].map ofMessage).foldl step FugueMaxClientCandidate.initial) = [3,1,2] ∧
    FugueMaxClientCandidate.visible
      (([g1,g2,g3].map ofMessage).foldl step FugueMaxClientCandidate.initial) = [3,2,1] ∧
    FugueMaxClientCandidate.visible
      (([g2,g3,g1].map ofMessage).foldl step FugueMaxClientCandidate.initial) = [1,3,2] ∧
    chainBuildBefore g1.chain g3.chain ∧ chainBuildBefore g2.chain g3.chain := by
  refine ⟨?_,?_,?_,?_,Or.inl ?_,Or.inl ?_⟩ <;> decide +kernel


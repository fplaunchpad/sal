import Sal.MRDTs.Instances.CapabilityGroup
import Mathlib.Data.Finset.Union
import Mathlib.Data.Finset.Card

/-! The source protocol admits fresh operations at complete local causal cuts
and reconciles compatible logs. It is independent of Sal's version-DAG network.
The companion SourceExecution module relates the two protocols. -/
namespace Sal.MRDTs.Instances.CapabilityGroup

/-- A minimal source protocol: replicas can issue at their complete local cut
and reconcile compatible logs. Authentication is supplied by the actor field.
This protocol is deliberately separate from Sal's version-DAG network. -/
inductive SourceReach (owner : Actor) : State → Prop where
  | empty : SourceReach owner ∅
  | issue {s e} : SourceReach owner s → CanIssue owner s e →
      SourceReach owner (step s e)
  | reconcile {s t} : SourceReach owner s → SourceReach owner t →
      (∀ a ∈ s, ∀ b ∈ t, a.id = b.id → a = b) → SourceReach owner (s ∪ t)

/-- Both validity and immutable admission are preserved by every source
protocol execution, including compatible reconciliation. -/
theorem SourceReach.valid {owner : Actor} {s : State} (h : SourceReach owner s) :
    WellFormed s ∧ LocallyAdmitted owner s := by
  induction h with
  | empty => exact ⟨wellFormed_empty, by intro e he; exact (Finset.notMem_empty e he).elim⟩
  | issue _ hc ih =>
      exact ⟨wellFormed_step ih.1 hc.1, locallyAdmitted_step ih.1 ih.2 hc⟩
  | reconcile _ _ hc ihs iht =>
      exact ⟨wellFormed_union ihs.1 iht.1 hc,
        locallyAdmitted_union ihs.1 iht.1 hc ihs.2 iht.2⟩

theorem wellFormed_pre {s : State} (hs : WellFormed s) {e : Event} (he : e ∈ s) :
    WellFormed (pre s e) := by
  constructor
  · intro a ha b hb hid
    exact hs.unique a ((mem_pre s e a).mp ha).1 b ((mem_pre s e b).mp hb).1 hid
  · intro a ha i hi
    obtain ⟨has, hae⟩ := (mem_pre s e a).mp ha
    obtain ⟨p, hp, hpid⟩ := hs.closed a has i hi
    refine ⟨p, (mem_pre s e p).mpr ⟨hp, ?_⟩, hpid⟩
    change p.id ∈ e.past
    rw [hpid]
    exact hs.downward e he a has hae hi
  · intro a ha p hp hb
    exact hs.downward a ((mem_pre s e a).mp ha).1 p ((mem_pre s e p).mp hp).1 hb
  · intro a ha i hi
    exact hs.ranked a ((mem_pre s e a).mp ha).1 i hi

theorem freshAt_pre {s : State} (hs : WellFormed s) {e : Event} (he : e ∈ s) :
    FreshAt (pre s e) e := by
  constructor
  · ext i
    constructor
    · intro hi
      obtain ⟨p, hp, hpid⟩ := hs.closed e he i hi
      exact Finset.mem_image.mpr ⟨p, (mem_pre s e p).mpr ⟨hp, by simpa [before, hpid] using hi⟩, hpid⟩
    · intro hi
      obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hi
      exact ((mem_pre s e p).mp hp).2
  · intro p hp
    exact hs.ranked e he p.id ((mem_pre s e p).mp hp).2

theorem pre_strict {s : State} (hs : WellFormed s) {e : Event} (he : e ∈ s) :
    pre s e ⊂ s := by
  refine Finset.ssubset_iff_subset_ne.mpr ⟨fun p hp => ((mem_pre s e p).mp hp).1, ?_⟩
  intro equal
  have hself : e ∈ pre s e := equal.symm ▸ he
  exact Nat.lt_irrefl e.id (hs.ranked e he e.id ((mem_pre s e e).mp hself).2)

theorem SourceReach.biUnion {owner : Actor} {α : Type} [DecidableEq α]
    (indices : Finset α) (branch : α → State) (ambient : State)
    (unique : ∀ a ∈ ambient, ∀ b ∈ ambient, a.id = b.id → a = b)
    (subset : ∀ i ∈ indices, branch i ⊆ ambient)
    (reachable : ∀ i ∈ indices, SourceReach owner (branch i)) :
    SourceReach owner (indices.biUnion branch) := by
  induction indices using Finset.induction_on with
  | empty => simpa using (SourceReach.empty : SourceReach owner ∅)
  | @insert i rest hi ih =>
    rw [Finset.biUnion_insert]
    refine SourceReach.reconcile (reachable i (Finset.mem_insert_self _ _))
      (ih (fun j hj => subset j (Finset.mem_insert_of_mem hj))
        (fun j hj => reachable j (Finset.mem_insert_of_mem hj))) ?_
    intro a ha b hb hid
    obtain ⟨j, hj, hb⟩ := Finset.mem_biUnion.mp hb
    exact unique a (subset i (Finset.mem_insert_self _ _) ha)
      b (subset j (Finset.mem_insert_of_mem hj) hb) hid

/-- Every finite valid, locally admitted source log can be generated by fresh
issuance at causal cuts and compatible reconciliation. The construction does
not assume a completed run or an externally supplied ordering witness. -/
theorem SourceReach.of_valid {owner : Actor} {s : State}
    (hs : WellFormed s) (ha : LocallyAdmitted owner s) : SourceReach owner s := by
  revert hs ha
  refine Finset.strongInductionOn s ?_
  intro current ih hs ha
  let branch : Event → State := fun e => step (pre current e) e
  have branch_subset : ∀ e ∈ current, branch e ⊆ current := by
    intro e he p hp
    rcases Finset.mem_insert.mp hp with hp | hp
    · exact hp ▸ he
    · exact ((mem_pre current e p).mp hp).1
  have branch_reachable : ∀ e ∈ current, SourceReach owner (branch e) := by
    intro e he
    have cut_wf := wellFormed_pre hs he
    have cut_subset : pre current e ⊆ current := fun p hp => ((mem_pre current e p).mp hp).1
    have cut_admitted : LocallyAdmitted owner (pre current e) := by
      intro p hp
      exact (admission_stable cut_wf hs cut_subset hp).mpr (ha p (cut_subset hp))
    have cut_reachable := ih (pre current e) (pre_strict hs he) cut_wf cut_admitted
    have cut_issue : CanIssue owner (pre current e) e := by
      refine ⟨freshAt_pre hs he, ?_⟩
      have idem : pre (pre current e) e = pre current e := by
        ext p
        simp [mem_pre]
      unfold admitted
      rw [idem]
      exact ha e he
    exact SourceReach.issue cut_reachable cut_issue
  have joined := SourceReach.biUnion current branch current hs.unique branch_subset branch_reachable
  have cover : current.biUnion branch = current := by
    ext p
    constructor
    · intro hp
      obtain ⟨e, he, hp⟩ := Finset.mem_biUnion.mp hp
      exact branch_subset e he hp
    · intro hp
      exact Finset.mem_biUnion.mpr ⟨p, hp, Finset.mem_insert_self _ _⟩
  exact cover ▸ joined

theorem sourceReach_iff_valid (owner : Actor) (s : State) :
    SourceReach owner s ↔ WellFormed s ∧ LocallyAdmitted owner s :=
  ⟨SourceReach.valid, fun h => SourceReach.of_valid h.1 h.2⟩


end Sal.MRDTs.Instances.CapabilityGroup

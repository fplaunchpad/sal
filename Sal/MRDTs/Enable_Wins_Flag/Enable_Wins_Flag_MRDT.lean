/-!
# Enable-Wins Flag (Correct): state-based MRDT

A per-replica enable-wins flag using a map from replica IDs to (counter, flag) pairs.
Each replica tracks an enable counter and the current flag state.

* `Enable`: increments the counter for this replica and sets flag to true
* `Disable`: sets the flag to false globally (across all replicas)

The merge rule resolves conflicts by checking whether counters have advanced since the LCA.
-/

/-- Type alias for flag state: (counter, boolean). -/
abbrev cf := ℕ × Bool

/-- Σ = map replica_id → (counter, flag). -/
@[simp] abbrev concrete_st := map ℕ cf

/-- Default lookup: unmapped replicas have counter 0 and flag false. -/
@[simp]
def mysel (s: concrete_st) (k: ℕ) : cf :=
if (contains s k) then (sel s k) else (0, false)

/-- Initial state: all replicas have counter 0 and flag false. -/
@[simp]
def init_st : concrete_st := const (0, false)

/-- Pointwise equality: agree on domain + per-key value. -/
@[simp]
def eq (a b: concrete_st) := (forall id: ℕ, (contains a id = contains b id) ∧ (mysel a id = mysel b id))

/-- Op payload is the replica ID and the operation type. -/
inductive app_op_t : Type where
| Enable
| Disable

abbrev op_t := ℕ × ℕ × app_op_t

@[simp]
def get_rid (o: op_t) : ℕ :=
match o with
| (_, rid, _) => rid

@[simp]
def distinct_ops (op1 op2: op_t) := Prod.fst op1 != Prod.fst op2

/-- Effect:
  * `Enable` on replica rid: increment counter for rid and set flag to true.
  * `Disable`: set flag to false for all replicas.
-/
@[simp]
def do_ (s: concrete_st) (o: op_t) : concrete_st :=
match o with
| (_, rid, .Enable) =>
    let (cnt, flag) := mysel s rid
    upd s rid (cnt + 1, true)
| (_, _, .Disable) =>
    map_val (fun (cnt, _) => (cnt, false)) s

/-- Conflict resolution order. -/
inductive rc_res : Type where
| Fst_then_snd
| Snd_then_fst
| Either

/-- `rc` orders Enable ↔ Disable operations. -/
@[simp]
def rc (o1 o2: op_t) : rc_res :=
match (Prod.snd (Prod.snd o1), Prod.snd (Prod.snd o2)) with
| (.Enable, .Disable) => rc_res.Snd_then_fst
| (.Disable, .Enable) => rc_res.Fst_then_snd
| _ => rc_res.Either

/-- Helper: merge a single (counter, flag) pair. -/
@[simp]
def merge_flag (l a b: cf) : Bool :=
let lc := Prod.fst l
let ac := Prod.fst a
let bc := Prod.fst b
let af := Prod.snd a
let bf := Prod.snd b
if af && bf then true
  else if not af && not bf then false
    else if af then ac > lc
      else bc > lc

/-- Helper: merge a single (counter, flag) pair, using the standard counter merge. -/
@[simp]
def merge_cf (l a b: cf) : cf :=
(Prod.fst a + Prod.fst b - Prod.fst l, merge_flag l a b)

/-- Merge: for each replica, merge its counter and flag using the rules above. -/
@[simp]
def merge (l a b: concrete_st) : concrete_st :=
let keys := union (domain l) (union (domain a) (domain b))
let u := const_on keys (0, false)
iter_upd (fun k v => merge_cf (mysel l k) (mysel a k) (mysel b k)) u

@[simp]
def commutes_with (o1 o2: op_t) :=
    forall s, eq (do_ (do_ s o1) o2) (do_ (do_ s o2) o1)

set_option maxHeartbeats 0


theorem rc_non_comm (o1: op_t) (o2: op_t):
distinct_ops o1 o2 ∧ get_rid o1 != get_rid o2
→
(rc o1 o2 = rc_res.Either ↔ commutes_with o1 o2) := by

sal


theorem no_rc_chain (o1 : op_t) (o2 : op_t) (o3 : op_t) :
(distinct_ops o1 o2 ∧ distinct_ops o2 o3)
→ (¬(rc o1 o2 = rc_res.Fst_then_snd ∧ rc o2 o3 = rc_res.Fst_then_snd))
:= by

sal

theorem cond_comm_base (s: concrete_st) (o1: op_t) (o2: op_t) (o3: op_t) :
(distinct_ops o1 o2 ∧ distinct_ops o2 o3 ∧ distinct_ops o1 o3
    ∧ rc o1 o2 = rc_res.Fst_then_snd ∧ ¬(rc o2 o3 = rc_res.Either))
→
eq (do_ (do_ (do_ s o1) o2) o3) (do_ (do_ (do_ s o2) o1) o3) := by

sal

theorem  merge_comm (l: concrete_st) (a: concrete_st) (b: concrete_st) :
eq (merge l a b) (merge l b a) := by

sal

theorem merge_idem (s: concrete_st):
eq (merge s s s) s := by


-- Test cases for increment and decrement
-- op_t = (op_id, replica_id, operation)

-- Test 1: Increment from initial state
-- Initial state: (0, {})
-- After Inc: (1, {})
#eval! do_ init_st (0, 0, app_op_t.Inc)  -- Expected: (1, {})

-- Test 2: Two increments
#eval! do_ (do_ init_st (0, 0, app_op_t.Inc)) (1, 0, app_op_t.Inc)  -- Expected: (2, {})

-- Test 3: Increment then decrement (should succeed since quota = 1)
#eval! do_ (do_ init_st (0, 0, app_op_t.Inc)) (1, 0, app_op_t.Dec)  -- Expected: (0, {})

-- Test 4: Decrement from initial state (should fail - no quota)
#eval! do_ init_st (0, 0, app_op_t.Dec)  -- Expected: (0, {}) - unchanged

-- Test 5: Two increments then two decrements
#eval! do_ (do_ (do_ (do_ init_st
  (0, 0, app_op_t.Inc))   -- (1, {})
  (1, 0, app_op_t.Inc))   -- (2, {})
  (2, 0, app_op_t.Dec))   -- (1, {})
  (3, 0, app_op_t.Dec)    -- Expected: (0, {})

-- Transfer test cases
-- Transfer (receiver, amount) - sender is the replica_id in op_t

-- Test 6: Transfer with no quota (should fail)
-- Replica 0 tries to transfer 1 to replica 1, but has no quota
#eval! do_ init_st (0, 0, app_op_t.Transfer 1 1)  -- Expected: (0, {}) - unchanged

-- Test 7: Increment then transfer
-- Replica 0 increments (gets quota 1), then transfers 1 to replica 1
#eval! do_ (do_ init_st
  (0, 0, app_op_t.Inc))           -- (1, {}) - replica 0 has quota 1
  (1, 0, app_op_t.Transfer 1 1)   -- Should record transfer from 0 to 1

-- Test 8: Transfer then decrement by receiver
-- Replica 0 increments, transfers to replica 1, then replica 1 decrements
#eval! do_ (do_ (do_ init_st
  (0, 0, app_op_t.Inc))           -- (1, {})
  (1, 0, app_op_t.Transfer 1 1))  -- Transfer 1 from replica 0 to replica 1
  (2, 1, app_op_t.Dec)            -- Replica 1 decrements (should succeed with transferred quota)

-- Test 9: Multiple replicas scenario
-- Replica 0 increments twice, transfers 1 to replica 1, both decrement
#eval! do_ (do_ (do_ (do_ (do_ init_st
  (0, 0, app_op_t.Inc))           -- (1, {})
  (1, 0, app_op_t.Inc))           -- (2, {})
  (2, 0, app_op_t.Transfer 1 1))  -- Transfer 1 from 0 to 1
  (3, 0, app_op_t.Dec))           -- Replica 0 decrements (has quota 2-1=1)
  (4, 1, app_op_t.Dec)            -- Replica 1 decrements (has transferred quota 1)



-- Lexicographic ordering for pairs of natural numbers
@[simp]
instance : Ord (ℕ × ℕ) where
  compare := fun (a1, a2) (b1, b2) =>
    match compare a1 b1 with
    | .lt => .lt
    | .gt => .gt
    | .eq => compare a2 b2

instance : Std.TransCmp (compare : ℕ × ℕ → ℕ × ℕ → Ordering) where
  eq_swap :=
  by sorry
  isLE_trans := by sal


-- Bounded Counter MRDT state: (counter_value, transfer_map)
-- transfer_map tracks quota transfers between replicas: (sender, receiver) -> amount

abbrev concrete_st := Int × Std.ExtTreeMap (ℕ × ℕ) Int


@[simp]
def init_st: concrete_st := (0, {})

@[simp]
def eq (a b: concrete_st) := a = b


-- Helper functions to access state components
@[simp]
def get_value (s: concrete_st) : Int := Prod.fst s

@[simp]
def get_transfers (s: concrete_st) := Prod.snd s

-- Calculate quota for a replica (simplified: just the counter value for now)
@[simp]
def quota (_replica: ℕ) (s: concrete_st) : Int :=
(Std.ExtTreeMap.foldl (fun value (sender, receiver) transferred =>
if sender = _replica then value - transferred
else if receiver = _replica then value + transferred
else value) (get_value s) (Prod.snd s))

-- Operation types
inductive app_op_t : Type where
| Inc
| Dec
| Transfer (receiver: ℕ) (amount: ℕ)

abbrev op_t:= ℕ × ℕ × app_op_t

@[simp]
def distinct_ops (op1 op2: op_t) := Prod.fst op1 != Prod.fst op2

@[simp]
def get_rid (o: op_t) :=
match o with
| (_, (rid, _)) => rid

-- Increment operation - always succeeds (increment by 1)
@[simp]
def inc (s: concrete_st) : concrete_st :=
  (get_value s + 1, get_transfers s)

-- Decrement operation - may fail if insufficient quota (decrement by 1)
@[simp]
def dec (replica: ℕ) (s: concrete_st) : concrete_st :=
  let q := quota replica s
  if q >= 1 then
    (get_value s - 1, get_transfers s)
  else
    s  -- If insufficient quota, state remains unchanged

-- Transfer quota from sender to receiver
@[simp]
def transfer (sender: ℕ) (receiver: ℕ) (amount: Int) (s: concrete_st) : concrete_st :=
  let q := quota sender s
  if q >= amount then
    let transfers := get_transfers s
    let pair := (sender, receiver)
    let value := if transfers.contains pair then transfers.get! pair else 0
    let new_transfers := transfers.insert pair value
    (get_value s, new_transfers)
  else
    s  -- If insufficient quota, state remains unchanged

-- Execute operation
@[simp]
def do_ (s: concrete_st) (o: op_t) : concrete_st :=
match o with
| (_, (_replica, app_op_t.Inc)) => inc s
| (_, (replica, app_op_t.Dec)) => dec replica s
| (_, (sender, app_op_t.Transfer receiver amount)) => transfer sender receiver amount s

inductive rc_res : Type where
| Fst_then_snd
| Snd_then_fst
| Either

@[simp]
def rc (_ _: op_t) := rc_res.Either

-- Three-way merge for MRDT: merge(lca, left, right)
@[simp]
def merge (l a b: concrete_st) : concrete_st :=
  -- Merge counter value using standard 3-way merge
  let merged_value := get_value a + get_value b - get_value l

  -- Merge transfer maps (take max for each key)
  let transfers_a := get_transfers a
  let transfers_b := get_transfers b
  let merged_transfers := Std.ExtTreeMap.mergeWith (fun _ v1 v2 => max v1 v2) transfers_a transfers_b

  (merged_value, merged_transfers)

@[simp]
def commutes_with (o1 o2: op_t) :=
    forall s, eq (do_ (do_ s o1) o2) (do_ (do_ s o2) o1)


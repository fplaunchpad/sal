import Mathlib.Data.Real.Basic
import Mathlib.Data.Set.Basic
import Std.Tactic.BVDecide

import CaseStudies.Interfaces.Map_extended
import CaseStudies.Tactics.Sal
import Blaster


@[simp] abbrev concrete_st_l := ℕ × ℕ


def mysel (s: map ℕ ((Int × Bool) × concrete_st_l)) k :=
if contains s k then sel s k else ((0,false), (0,0))

@[simp] abbrev concrete_st :=
map ℕ ((Int × Bool) × concrete_st_l)

@[simp]
def init_st_l : concrete_st_l:= (0,0)


@[simp]
def init_st : concrete_st := const_on empty ((0,false), init_st_l)

@[simp]
def eq (a b: concrete_st) :=
forall id, contains a id = contains b id ∧ mysel a id = mysel b id


inductive app_op_t : Type where
| Set : ℕ → app_op_t
| Unset

abbrev op_t:= ℕ × ℕ × app_op_t

@[simp]
def distinct_ops (op1 op2 : op_t) := (Prod.fst op1 != Prod.fst op2 ∧ Prod.fst op1 != 0 ∧ Prod.fst op2 != 0)
--the initial state already has ts 0, so further ops should have ts > 0

@[simp]
def get_rid (o : op_t) :=
match o with
| (_, (rid, _)) => rid

@[simp]
def do_ (s: concrete_st) (o: op_t) : concrete_st :=
match o with
| (ts, (rid, .Set v)) => upd s rid ((Prod.fst (Prod.fst (mysel s rid)) + 1, true), (ts, v))
| (_, (_, .Unset)) => map_val (fun ((c,f), (ts,v)) => ((c,false), init_st_l)) s

inductive rc_res : Type where
| Fst_then_snd
| Snd_then_fst
| Either

@[simp]
def rc (o1 o2 : op_t) :=
match (Prod.snd (Prod.snd o1)), (Prod.snd (Prod.snd o2)) with
| .Set _, .Unset => rc_res.Snd_then_fst
| .Unset, .Set _ => rc_res.Fst_then_snd
| _, _ => rc_res.Either


@[simp]
def commutes_with (o1 o2 : op_t) :=
    forall s, eq (do_ (do_ s o1) o2) (do_ (do_ s o2) o1)


@[simp]
def merge_l (l a b : concrete_st_l) : concrete_st_l :=
  if Prod.fst a = Prod.fst b then (Prod.fst a, (Prod.snd a + Prod.snd b)/2)
  else if Prod.fst a > Prod.fst b then a else b


@[simp]
def merge_flag (l a b: Int × Bool) : Bool:=
let lc := Prod.fst l
let ac := Prod.fst a
let bc := Prod.fst b
let af := Prod.snd a
let bf := Prod.snd b
if af && bf then true
  else if not af && not bf then false
    else if af then ac > lc
      else bc > lc


@[simp] def merge_cf (l a b : Int × Bool) : Int × Bool :=
(Prod.fst a + Prod.fst b - Prod.fst l, merge_flag l a b)

@[simp] def merge (l a b : concrete_st) : concrete_st :=
let keys := union (domain l) (union (domain a) (domain b))
let u := const_on keys (0,false)
iter_upd (fun k v => let mf := merge_cf (Prod.fst (mysel l k)) (Prod.fst (mysel a k)) (Prod.fst (mysel b k))
let ml := if not (Prod.snd mf) then init_st_l else if Prod.snd mf && not (Prod.snd (Prod.fst (mysel a k))) then Prod.snd (mysel b k)
else if Prod.snd mf && not (Prod.snd (Prod.fst (mysel b k))) then Prod.snd (mysel a k)
else merge_l (Prod.snd (mysel l k)) (Prod.snd (mysel a k)) (Prod.snd (mysel b k))
(mf, ml)) u


theorem rc_non_comm (o1: op_t) (o2: op_t):
distinct_ops o1 o2 ∧ get_rid o1 != get_rid o2
→
(rc o1 o2 = rc_res.Either ↔ commutes_with o1 o2) := by sal





theorem no_rc_chain (o1 : op_t) (o2 : op_t) (o3 : op_t) :
(distinct_ops o1 o2 ∧ distinct_ops o2 o3)
→ (¬(rc o1 o2 = rc_res.Fst_then_snd ∧ rc o2 o3 = rc_res.Fst_then_snd))
:= by blaster

theorem cond_comm_base (s: concrete_st) (o1: op_t) (o2: op_t) (o3: op_t) :
(distinct_ops o1 o2 ∧ distinct_ops o2 o3 ∧ distinct_ops o1 o3
    ∧ rc o1 o2 = rc_res.Fst_then_snd ∧ ¬(rc o2 o3 = rc_res.Either))
→
eq (do_ (do_ (do_ s o1) o2) o3) (do_ (do_ (do_ s o2) o1) o3) := by sal

theorem  merge_comm (l: concrete_st) (a: concrete_st) (b: concrete_st) :
eq (merge l a b) (merge l b a) := by sal

theorem merge_idem (s: concrete_st):
eq (merge s s s) s := by sal

theorem base_2op (o1: op_t) (o2: op_t):
(rc o2 o1 = rc_res.Fst_then_snd ∨ rc o2 o1 = rc_res.Either) ∧ get_rid o1 != get_rid o2 ∧ distinct_ops o1 o2
→
eq (merge init_st (do_ init_st o1) (do_ init_st o2)) (do_ (merge init_st init_st (do_ init_st o2)) o1) := by sal


